# HakiOS fragment: the Qualcomm SM8650 "pineapple" (Snapdragon 8 Gen 3) family -- what is true of the SoC, whatever phone it is in.
# SM8650 has 8 cores (2x Cortex-A520, 5x Cortex-A720, 1x Cortex-X4 prime); the biggest is core 7.
# The SoC's own drivers (chip identity, temperature sensors, PMIC inventory, core clocks) are enabled
# here, the way the SC7280 family enables them in sc7280.config: their addresses come from the
# phone's soc.args (soc_smem=, thermal_tm0/1/2=, soc_epss=, soc_rsc=, soc_cmd_db=, soc_arb_*= --
# read at start-up; the defaults are the reference phone's, redwood).
CONFIG_SOC="sm8650"
CONFIG_CPUS=1
CONFIG_BOOTCPU=7
# CONFIG_CPUFREQ is not set
# CONFIG_SOCINFO is not set
CONFIG_THERMAL=y
# the drivers of this SoC family are enabled from here
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_SOCINFO is not set
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
