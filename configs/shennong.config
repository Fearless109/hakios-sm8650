# HakiOS fragment: the Xiaomi 14 Pro (shennong, SM8650 "pineapple") -- what is true of this device and of no other.
# Unlike a fresh port (docs/porting/index.md leaves every phone driver out until made to work here),
# this port carries the full adaptation for shennong: every driver below is built in and pointed at
# SM8650 by devices/shennong/soc.args (soc_*) and the thermal block addresses. The ones whose
# controller differs fundamentally from the reference phone's have a device driver of their own
# (devices/shennong/drivers/): SYNAPTICS (the Synaptics S3910P touch screen, not a Goodix), ADRENO750
# (the Adreno 750, gen7; its own GMU/GPUCC offsets and a750_* firmware), SPEAKER_S (WCD939x + WSA
# codecs), HAPTIC_S (PM8550B hv-haptics), CAMERA_S (CCI sensors) and TORCH_S (flash on PM8550B).
# A driver left out here is left out of the kernel entirely (drivers/<subsystem>/conf); the run
# scripts pass soc.args, so each driver below starts only when its boot-arg is given.
CONFIG_DEVICE="shennong"
CONFIG_HAKIOS_ADSP=y
CONFIG_HAKIOS_SPEAKER_S=y
CONFIG_HAKIOS_SOUND=y
CONFIG_HAKIOS_MIC=y
CONFIG_HAKIOS_BT=y
CONFIG_HAKIOS_CAMERA_S=y
CONFIG_HAKIOS_TORCH_S=y
CONFIG_HAKIOS_ADRENO750=y
CONFIG_HAKIOS_HAPTIC_S=y
CONFIG_HAKIOS_SYNAPTICS=y
CONFIG_HAKIOS_PCIE_S=y
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_MODEM=y
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_CHG_S=y
CONFIG_HAKIOS_BATTGUARD=y
CONFIG_HAKIOS_UFS=y
CONFIG_HAKIOS_WIFI=y
# NOTE: the common (SC7280/redwood) drivers below are left OUT for shennong: their controller,
# addresses and firmware are the reference phone's, and a device driver above takes their place.
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# boot-arg options: the values shennong is run with (the run scripts add soc.args on top)
CONFIG_TOUCHSCREEN=y
CONFIG_GPU=y
CONFIG_ADSP=y
CONFIG_SOUND=4
CONFIG_MIC=4
CONFIG_WIFI=y
CONFIG_HAPTIC=5
CONFIG_CAM=4
CONFIG_TORCH=1
CONFIG_MODEM=y
CONFIG_MODEM_AGAIN=y
CONFIG_MODEM_BUFFER=0xa8000000
# CONFIG_SOCINFO is not set
CONFIG_THERMAL=y
CONFIG_PMIC=y
# CONFIG_CPUFREQ is not set
# CONFIG_SOC_CMD_DB is not set
# CONFIG_SOC_RSC is not set
# CONFIG_SOC_SMEM is not set
CONFIG_UFS=2
CONFIG_UFS_WRITE=y
CONFIG_VAR_STORE=y
# the panel runs at 120 Hz, 1440x3200 (6.73" LTPO AMOLED, DSC cmd): frames made at 120 Hz, and
# CoreAnimation clocked by the driver's refresh (redwood's 120 Hz setup, same values).
CONFIG_FB_HZ=120
CONFIG_CA_VBL=y
# HakiOS of shennong needs the phone's own firmware pulled from the phone (devices/shennong/pull-firmware.sh)
CONFIG_FIRMWARE="device"
# the three SM8650 TSENS blocks (tsens0/1/2): the status block of each (docs: thermal_tm0= in hakios.thermal.c)
CONFIG_THERMAL_TM0=0xc228000
CONFIG_THERMAL_TM1=0xc229000
CONFIG_THERMAL_TM2=0xc22a000
